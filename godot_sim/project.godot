; Engine configuration file.
; Easy Drive Campus Transport Fleet Simulation (Godot 4.7 - Compatibility Renderer)

config_version=5

[application]

config/name="Easy Drive Campus Transit Sim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Compatibility")

[rendering]

renderer/rendering_method="compatibility"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1024
window/size/window_height_override=576
